# syntax=docker/dockerfile:1.7

# Dockerfile.worker — the indexer worker deployable (phase-03 §1/§17).
#
# This is the first real content of the worker as a deployable: it serves only the
# repository.* Inngest functions and is built and shipped separately from apps/api and
# apps/web (plan.md §1.3 change ③). It must NOT go to Vercel — tarball extraction and
# (Phase 04/05) parsing/embedding are minutes of CPU and hundreds of MB of disk, which
# serverless execution limits and read-only filesystems make fragile. See
# docs/deployment.md's "Worker container" section for the deploy-target discussion.
#
# ## Build strategy: `turbo prune`, not a plain `pnpm install` over the whole monorepo
#
# `turbo prune worker --docker` (verified against the installed turbo@2.10.11 — see
# docs/decisions/phase-03-log.md) computes the exact workspace subset apps/worker needs
# — @repo/db, @repo/github, @repo/observability, @repo/shared, worker — and splits it
# into `out/json/` (pruned package.json files + the lockfile, for a cache-friendly
# `pnpm install` layer) and `out/full/` (pruned real source). apps/web and apps/api's
# code, tests, and dependencies never enter this image at all.
#
# ## Why the four workspace packages need their own `pnpm build` step
#
# @repo/db, @repo/github, @repo/observability, and @repo/shared all originally shipped
# `"exports": {".": "./src/index.ts"} — raw TypeScript source, resolvable by tsc/tsx/
# vitest but not by plain `node` running compiled output. Verified directly: before this
# phase gave each of them a real `tsc` build and a `dist/`-pointing `exports` field,
# `node dist/server.js` failed immediately with `ERR_MODULE_NOT_FOUND` on the very first
# cross-package import (docs/decisions/phase-03-log.md has the full trace). This container
# is the first place in the repository that actually runs a compiled build with plain
# `node` rather than a TypeScript-aware dev runner — which is exactly what surfaced it.

ARG NODE_VERSION=22-slim
ARG PNPM_VERSION=11.2.2

# ---------------------------------------------------------------------------
# Stage 1 — prune the monorepo down to what apps/worker actually needs
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS pruner
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY . .
RUN pnpm dlx turbo@2.10.11 prune worker --docker

# ---------------------------------------------------------------------------
# Stage 2 — install dependencies from the pruned lockfile (cache-friendly: this layer
# only invalidates when a package.json or the lockfile changes, not on every source edit)
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# Stage 3 — build: overlay the real pruned source onto the installed node_modules, then
# compile the workspace packages and apps/worker itself
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS builder
WORKDIR /app
# @prisma/engines' postinstall (a transitive dependency even under the driver-adapter
# setup this repo uses — no native query engine is actually invoked, see this file's
# header comment) probes for libssl to pick an engine binary and warns loudly without
# it. Installing it is cheap and turns a "prisma:warn ... may not work as expected"
# into nothing, rather than trusting that the fallback it silently picks is fine.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
# `turbo prune --docker` scopes `out/full` to the packages apps/worker actually depends
# on and does not know to carry along the workspace ROOT tsconfig.json that each of
# their own tsconfig.json files `extends` — copied explicitly rather than assuming
# prune would infer a file no package.json references directly.
COPY tsconfig.json ./tsconfig.json
RUN pnpm --filter @repo/db db:generate
RUN pnpm build --filter=worker...

# ---------------------------------------------------------------------------
# Stage 4 — a second, production-only install, so the runtime image excludes
# devDependencies (typescript, vitest, tsx, @types/*, …) that the build stage needed
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS prod-deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile --prod

# ---------------------------------------------------------------------------
# Stage 5 — runtime: non-root, minimal, only compiled output + prod node_modules
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production

# A dedicated, unprivileged user — never run the process as root (§4 Security,
# plan.md §35.10). Debian's node:*-slim base has no such user by default.
RUN groupadd --system --gid 1001 worker \
  && useradd --system --uid 1001 --gid worker --home-dir /app --shell /usr/sbin/nologin worker

COPY --from=prod-deps --chown=worker:worker /app/node_modules ./node_modules
COPY --from=prod-deps --chown=worker:worker /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=prod-deps --chown=worker:worker /app/packages ./packages
COPY --from=builder --chown=worker:worker /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=worker:worker /app/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=worker:worker /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder --chown=worker:worker /app/packages/github/dist ./packages/github/dist
COPY --from=builder --chown=worker:worker /app/packages/observability/dist ./packages/observability/dist
COPY --from=builder --chown=worker:worker /app/packages/shared/dist ./packages/shared/dist
COPY --from=pruner --chown=worker:worker /app/package.json ./package.json
COPY --from=pruner --chown=worker:worker /app/apps/worker/package.json ./apps/worker/package.json

# WORKER_TEMP_DIR (§19) — tarball extraction scratch space. The root filesystem is
# read-only at runtime (see the compose/deploy config's `read_only: true` +
# `tmpfs: /tmp/worker`), so this must be a writable mount, not a plain directory baked
# into the image. Created here so it exists (and is owned by the worker user) even
# before a tmpfs is mounted over it in an environment that forgets to configure one —
# degrading to "extraction fails cleanly" rather than "fails to even create the dir".
RUN mkdir -p /tmp/worker && chown worker:worker /tmp/worker
ENV WORKER_TEMP_DIR=/tmp/worker

USER worker

EXPOSE 4500

# `/api/inngest` answers GET with the registered-functions payload with no auth
# required (the Inngest SDK's own introspection endpoint) — a real, cheap liveness
# signal that the Express app and the Inngest handler are both up, not just that the
# process exists. Uses Node's own fetch rather than curl/wget, neither of which the
# slim base image ships.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.WORKER_PORT||4500)+'/api/inngest').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/worker/dist/server.js"]
