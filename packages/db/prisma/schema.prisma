// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Phase 01 field-complete schema (plan.md §24.2/§25, phase-01-authentication-and-projects.md
// §6) — supersedes Phase 00's placeholder User/Project. See
// docs/decisions/phase-01-log.md for the User/Auth.js-adapter reconciliation notes and the
// BigInt-serialization decision.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  moduleFormat    = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  githubUserId BigInt   @unique
  githubLogin  String
  email        String?  @unique
  avatarUrl    String?
  plan         String   @default("free")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth.js Prisma adapter columns — additive, not in phase-01 §6's field list (see
  // docs/decisions/phase-01-log.md). `email` above is reused for both the phase
  // document's identity field and the adapter's getUserByEmail lookup, which is why
  // it carries @unique despite phase-01 §6 not specifying one — verified empirically
  // against the installed @auth/prisma-adapter's source, not assumed. `image`
  // duplicates `avatarUrl`; both are populated from the same GitHub profile field in
  // the provider's profile() callback so they can never diverge.
  name          String?
  image         String?
  emailVerified DateTime?

  projects      Project[]
  installations GithubInstallation[]
  accounts      Account[]
  sessions      Session[]

  @@index([githubUserId])
}

model Project {
  id        String    @id @default(uuid())
  userId    String
  name      String
  slug      String
  settings  Json      @default("{}")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  repositories Repository[]

  @@unique([userId, slug])
  @@index([userId, deletedAt])
}

// Schema only in this phase — no rows are written until Phase 02 connects a
// repository through the GitHub App (phase-01 §3/§6).
model GithubInstallation {
  id             String    @id @default(uuid())
  installationId BigInt    @unique
  accountLogin   String
  accountType    String
  userId         String
  suspendedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase 02 (phase-02-github-repository-integration.md §6). A GitHub repository
// connected to a Project through a GitHub App installation. Created in indexStatus
// PENDING; nothing in Phase 02 moves it further — Phase 03 owns every other transition.
//
// Four deliberate departures from / additions to §6's block, each argued in
// docs/decisions/phase-02-log.md §4:
//   · htmlUrl added — §6's Prisma block omits it, but §4 Data Requirements and
//     plan.md §24.2 both list it as required.
//   · sizeBytes / webhookId added as nullable — plan.md §24.2 has them, §6 doesn't;
//     both follow §6's own "declare later-phase fields now" rationale.
//   · installationId stays a plain BigInt, NOT a foreign key to GithubInstallation,
//     even though that relation is possible (GithubInstallation.installationId is
//     @unique). A real FK would cascade-delete these rows when the App is uninstalled;
//     losing connection history is worse than the missing referential integrity, and
//     ACCESS_LOST exists precisely to represent "installation gone, row kept".
//   · No standalone @@index([projectId]) — plan.md §24.2 lists one, but
//     @@unique([projectId, githubRepoId]) already creates a projectId-prefixed
//     composite index that serves WHERE projectId = ? equally well.
//
// githubRepoId is deliberately NOT globally unique: the same GitHub repository may be
// connected to two different projects, and both connections must work independently
// (§4 FR / plan.md §45's named failure point for this phase). Every query keys on
// (projectId, githubRepoId), never githubRepoId alone.
model Repository {
  id               String      @id @default(uuid())
  projectId        String
  installationId   BigInt
  githubRepoId     BigInt
  owner            String
  name             String
  fullName         String
  defaultBranch    String
  isPrivate        Boolean     @default(true)
  htmlUrl          String
  sizeBytes        Int?
  webhookId        BigInt?
  // ACTIVE | DISCONNECTED | ACCESS_LOST. A String, not an enum — both source documents
  // specify it that way, in contrast to indexStatus below. The legal values are pinned
  // as a TypeScript union in apps/api/src/modules/repositories/repository.types.ts so
  // nothing type-unsafe leaks upward.
  connectionStatus String      @default("ACTIVE")
  indexStatus      IndexStatus @default(PENDING)

  // Declared now, null/default until Phase 03–05 populate them (§6) — declaring them
  // up front avoids a schema-churning migration mid-indexing-buildout.
  indexedCommitSha String?
  indexVersion     Int       @default(1)
  indexedFileCount Int       @default(0)
  skippedFileCount Int       @default(0)
  reviewProfile    String?
  lastIndexedAt    DateTime?
  indexError       Json?

  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files        RepositoryFile[]
  indexJobs    IndexJob[]
  // Phase 04 — the relational layer (plan.md §9's Repository Knowledge Model). Not in
  // Phase 02's own §6 block; added when CodeSymbol/CodeDependency were.
  symbols      CodeSymbol[]
  dependencies CodeDependency[]
  // Phase 06 — the minimal PullRequest row a webhook can populate with no GitHub call.
  pullRequests PullRequest[]
  // Phase 05 — the semantic layer (plan.md §9's Repository Knowledge Model).
  chunks       CodeChunk[]

  @@unique([projectId, githubRepoId])
  @@index([githubRepoId])
  @@index([indexStatus])
}

// Phase 03 (phase-03-repository-indexing.md §6). One row per *current path*, not per
// commit — historical file versions aren't modeled; commitSha records when a path was
// last indexed. Keeps the table at repo-size rather than repo-size × commit-count
// (plan.md §24.2). Only files that reach the hashing step get a row at all: hard-ignored
// paths (node_modules/**, .git/**, etc.) never produce one, per plan.md §8.2 step 4.
//
// indexState/skipReason/parseState are plain Strings, matching the same String-vs-enum
// split Repository.connectionStatus already has next to the real IndexStatus enum
// (docs/decisions/phase-02-log.md §5) — legal values are pinned as TypeScript unions in
// @repo/shared's indexing.ts (IndexState, SkipReason, ParseState) rather than enforced by
// the database. See docs/decisions/phase-03-log.md, sub-task 1.3.
model RepositoryFile {
  id               String             @id @default(uuid())
  repositoryId     String
  path             String
  commitSha        String
  language         String?
  contentHash      String
  sizeBytes        Int
  lineCount        Int                @default(0)
  packageName      String?
  classification   FileClassification @default(UNKNOWN)
  indexState       String             @default("INDEXED") // IndexState — INDEXED | SKIPPED | FAILED
  skipReason       String? // SkipReason — SKIPPED_* codes, null when indexState=INDEXED
  parseState       String             @default("OK") // ParseState — only "OK" reachable before Phase 04
  symbolCount      Int                @default(0) // populated starting Phase 04
  inboundEdgeCount Int                @default(0) // populated starting Phase 04
  isTest           Boolean            @default(false)
  isGenerated      Boolean            @default(false)
  updatedAt        DateTime           @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  // Phase 04 — every CodeSymbol extracted from this file (phase-04 §6). Cascades: a
  // file re-indexed to a new commit or deleted takes its symbols with it; the
  // graph-builder (Prompt 4) is what re-creates them for the new commit.
  symbols CodeSymbol[]
  // Phase 05 — every CodeChunk sliced from this file. Cascades for the identical reason
  // symbols above does: a file re-indexed to a new commit takes its old chunks with it.
  chunks  CodeChunk[]

  @@unique([repositoryId, path])
  @@index([repositoryId, contentHash])
  @@index([repositoryId, packageName])
  // Not in §6's own Prisma block, but plan.md §24.2 lists it and Prompt 2's "list
  // skipped files" / reconciliation queries (§14 Database Verification) need it. Same
  // "declare it, it's cheap, plan.md already specifies it" rationale §6 itself uses
  // elsewhere. See docs/decisions/phase-03-log.md.
  @@index([repositoryId, indexState])
}

enum FileClassification {
  SOURCE
  TEST
  CONFIG
  GENERATED
  DEPENDENCY_LOCK
  DOCUMENTATION
  ASSET
  UNKNOWN
}

// Phase 04 (phase-04-code-parsing-and-knowledge-graph.md §6). One row per extracted
// symbol (function, arrow-function-const, class, method, interface, type alias, enum,
// React component, hook — @repo/shared's SYMBOL_KINDS). `kind` is a plain String, not a
// Postgres enum — matching the `indexState`/`skipReason`/`parseState` precedent on
// RepositoryFile above, for the identical reason (docs/decisions/phase-03-log.md §6):
// the legal values are pinned in @repo/shared instead.
//
// `parentSymbolId` — a plain nullable id, deliberately NOT a Prisma self-relation.
// phase-04 §4 Data Requirements lists "parent symbol" among CodeSymbol's fields; §6's
// own Prisma block omits it entirely. Added per §4 over the incomplete §6 block — a
// method needs to point at its enclosing class or the containment information is lost.
// Not a self-relation because a self-relation's cascade-delete semantics were never
// asked for here; a plain id column with no FK is enough for `WHERE parentSymbolId = ?`
// lookups and never risks a surprise cascade through the symbol tree.
model CodeSymbol {
  id             String  @id @default(uuid())
  repositoryId   String
  fileId         String
  name           String
  kind           String // SymbolKind (@repo/shared) — FUNCTION | ARROW_FUNCTION | CLASS | METHOD | INTERFACE | TYPE_ALIAS | ENUM | REACT_COMPONENT | HOOK | VARIABLE
  startLine      Int
  endLine        Int
  isExported     Boolean @default(false)
  isDefault      Boolean @default(false)
  signature      String?
  docComment     String?
  parentSymbolId String? // the enclosing class/interface's CodeSymbol.id, for methods — see above
  complexity     Int     @default(0)
  commitSha      String

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  // Phase 05 — chunks anchored to this symbol. onDelete: SetNull on CodeChunk.symbol
  // (not Cascade) is the load-bearing half of this relation: Phase 04's graph builder
  // deletes and rebuilds every symbol on each re-parse, and a cascade here would
  // silently destroy embeddings on every re-index rather than just orphaning the anchor.
  chunks     CodeChunk[]

  // Symbol identity — the conflict target for Prompt 4's multi-row upsert (phase-04 §8:
  // "pass 1 writes are upserts on ... symbol identity"). Two symbols cannot share a
  // file, a name, a kind, and a start line.
  @@unique([repositoryId, fileId, name, kind, startLine])
  @@index([fileId])
  @@index([repositoryId, name]) // used constantly by call resolution (§6's own comment)
  @@index([repositoryId, isExported])
}

// Phase 04 §6. The `kind` enum genuinely is a Postgres enum here (unlike CodeSymbol.kind
// above) — @repo/shared's DEPENDENCY_KINDS mirrors it for the module-load-time
// DATABASE_URL reason documented there, not because this column itself is a String.
enum DependencyKind {
  IMPORTS
  EXPORTS
  CONTAINS
  CALLS
  EXTENDS
  IMPLEMENTS
  REFERENCES
  TESTS
}

// Phase 04 §6. One edge table, two granularities (file-level via from/toFileId,
// symbol-level via from/toSymbolId), filtered by `kind` — plan.md §11.1: "a separate
// graph database is unnecessary complexity at this scale."
//
// Deliberately has NO foreign keys to RepositoryFile or CodeSymbol, despite from/to
// columns that reference their ids. A real FK would force `fromFileId`/`toFileId` and
// `fromSymbolId`/`toSymbolId` to always agree on which pair is populated for a given
// row's granularity, which Postgres FK constraints cannot express conditionally, and
// would cascade-delete edges the instant a single endpoint's symbol is deleted — which
// is exactly backwards for a two-pass graph-builder that deletes and rebuilds all of a
// file's symbols on every re-parse (Prompt 4's write order: edges deleted before
// symbols, precisely because a dangling toSymbolId is expected and harmless between
// those two steps, never queried mid-rebuild). Consumers must treat from/toSymbolId as
// "may point at a since-deleted symbol" rather than a referential guarantee.
//
// The composite uniqueness constraint below (repositoryId, kind, fromFileId, toFileId,
// fromSymbolId, toSymbolId) needs Postgres's NULLS NOT DISTINCT, which Prisma's schema
// language cannot express (no @@unique syntax for it) — every file-level edge has two
// NULL symbol columns, and without NULLS NOT DISTINCT, Postgres treats every NULL as
// distinct, so a plain @@unique would let the same file-level edge be inserted an
// unbounded number of times. Declared instead as raw SQL appended to this model's
// migration (packages/db/prisma/migrations/*_add_code_symbol_and_code_dependency/
// migration.sql) — NOT declared as @@unique here. Do not `prisma db push` against this
// schema without also applying that migration; db push would silently drop the
// constraint since nothing in this file describes it. For the same reason, `prisma
// migrate dev` (no --name) will prompt to create a NEW migration that DROPS this
// constraint, because its shadow-database drift check has no schema.prisma declaration
// to reconcile the constraint against — do not accept that prompt. Use `prisma migrate
// status` to check and `prisma migrate deploy` to apply (docs/decisions/phase-04-log.md).
model CodeDependency {
  id              String         @id @default(uuid())
  repositoryId    String
  kind            DependencyKind
  fromFileId      String?
  toFileId        String?
  fromSymbolId    String?
  toSymbolId      String?
  externalPackage String?
  rawSpecifier    String?
  resolution      String         @default("RESOLVED") // DependencyResolution (@repo/shared) — RESOLVED | EXTERNAL | UNRESOLVED
  confidence      Float          @default(1.0)
  commitSha       String

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, toSymbolId, kind])
  @@index([repositoryId, fromFileId, kind])
  @@index([repositoryId, toFileId, kind])
  // Phase 04 prompt-1 §2.7 — outbound symbol traversal (plan.md §9: "Traversed outbound
  // gives dependencies the changed code relies on"). None of the three indexes above
  // serve `WHERE repositoryId = ? AND fromSymbolId = ANY(...) AND kind = ?`.
  @@index([repositoryId, fromSymbolId, kind])
}

// Phase 05 (phase-05-vector-search.md §6). One row per AST-anchored chunk of a source
// file, plus its embedding — the semantic layer of the repository knowledge model
// (plan.md §9), complementing Phase 04's relational graph.
//
// Four deliberate departures from §6's own Prisma block, each argued in
// docs/decisions/phase-05-log.md:
//
//   · `projectId` is DROPPED. §6 declares it, but with no relation, no index, and no
//     reader anywhere in the phase. Every sibling indexing table (RepositoryFile,
//     CodeSymbol, CodeDependency) keys on repositoryId alone, and requireTenantAccess
//     already resolves a repository up to its project in one query. A denormalized
//     projectId with no foreign key is a column that can silently disagree with
//     Repository.projectId and that nothing would notice.
//
//   · `embedding` is NULLABLE, not `NOT NULL` as §6 has it. §4 Reliability and §8
//     Failure behavior both require a repository to reach indexStatus=PARTIAL with
//     chunksEmbedded < total and be resumable later. A row must therefore be able to
//     exist with content and without a vector. Making it NOT NULL would force
//     "embed first, insert second", which in turn would force the resume sweeper to
//     re-download and re-chunk the whole repository from GitHub, because the extracted
//     tarball is deleted the moment indexer.service.ts's onExtracted callback returns.
//
//   · `embedding` and `tsv` are declared as `Unsupported(...)`, not omitted. Prisma's
//     schema language cannot express halfvec or a GENERATED ALWAYS AS ... STORED
//     column, and Phase 04 already learned (see CodeDependency's comment) that DDL
//     Prisma cannot see is DDL `prisma migrate dev` proposes to DROP. Declaring them as
//     optional Unsupported fields keeps them visible to the migration engine while
//     excluding them from the typed client — which is what we want, since every read and
//     write of both columns goes through raw SQL in packages/db/src/vector/.
//
//   · `symbols`/`imports` are denormalized String[] arrays, per §4 Data Requirements, so
//     a filter on "chunks that mention symbol X" needs no join back to CodeSymbol.
//
// ALL vector reads and writes go through $queryRaw/$executeRaw inside the pgvector
// VectorStore implementation (Prompt 2) — never through Prisma's query builder.
model CodeChunk {
  id             String   @id @default(uuid())
  repositoryId   String
  fileId         String
  symbolId       String?
  commitSha      String
  filePath       String
  packageName    String?
  language       String
  chunkKind      String // ChunkKind (@repo/shared) — FILE_HEADER | SYMBOL | NEIGHBORHOOD | WINDOW
  startLine      Int
  endLine        Int
  content        String
  contentHash    String
  symbols        String[] @default([])
  imports        String[] @default([])
  tokenCount     Int
  embeddingModel String
  createdAt      DateTime @default(now())

  // Added by the raw-SQL half of this model's migration; see the header comment above.
  embedding Unsupported("halfvec(1024)")?
  tsv       Unsupported("tsvector")?

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  symbol     CodeSymbol?    @relation(fields: [symbolId], references: [id], onDelete: SetNull)

  // §4 Reliability: re-running the embedding step must be idempotent.
  @@unique([repositoryId, contentHash, startLine, filePath])
  @@index([repositoryId, commitSha])
  @@index([repositoryId, filePath])
}

// Phase 05 §6. Content-hash → embedding, shared GLOBALLY across repositories rather than
// scoped per repository (§3): boilerplate and vendored code repeat constantly across
// codebases, and this is free deduplication worth an expected 15-40% hit rate
// (plan.md §37.3 item 6).
//
// Deliberately holds no content and no repositoryId — only the hash, the model, the
// vector, and usage counters. A hit is only reachable by a caller who already possesses
// the exact bytes that produced the hash, so a shared cache is not a cross-tenant read
// path for source code. See docs/decisions/phase-05-log.md.
//
// The 90-day sweep of unused rows (§4 Data Requirements) is a later cost-hardening
// concern; this phase builds only the table and the read/write path.
model EmbeddingCache {
  contentHash String   @id
  model       String
  hits        Int      @default(0)
  lastUsedAt  DateTime @default(now())

  embedding Unsupported("halfvec(1024)")?

  @@index([lastUsedAt])
}

// Phase 03 §6. One row per indexing run — Postgres mirror of Inngest's execution state,
// polled by the UI ("Inngest is the executor, Postgres is the status of record",
// plan.md §27.6). status/mode are plain Strings; legal values are IndexJobStatus/
// IndexJobMode in @repo/shared's indexing.ts.
model IndexJob {
  id                 String    @id @default(uuid())
  repositoryId       String
  mode               String // IndexJobMode — FULL | INCREMENTAL (only FULL used this phase)
  status             String // IndexJobStatus — PENDING | RUNNING | SUCCEEDED | FAILED
  targetCommitSha    String?
  previousCommitSha  String?
  inngestRunId       String?
  filesTotal         Int       @default(0)
  filesProcessed     Int       @default(0)
  filesSkipped       Int       @default(0)
  symbolsCreated     Int       @default(0) // 0 in this phase; Phase 04 populates
  edgesCreated       Int       @default(0) // 0 in this phase; Phase 04 populates
  chunksEmbedded     Int       @default(0) // 0 in this phase; Phase 05 populates
  embeddingCacheHits Int       @default(0) // 0 in this phase; Phase 05 populates
  currentStep        String?
  progressPercent    Int       @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  error              Json? // { code: IndexErrorCode, message, ...details }
  attempts           Int       @default(0)
  createdAt          DateTime  @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([status])
}

// Full lifecycle declared now; only (none) → PENDING is reachable in Phase 02 (§11).
enum IndexStatus {
  PENDING
  INDEXING
  INDEXED
  UPDATING
  FAILED
  PARTIAL
}

// Phase 06 (phase-06-webhook-ingestion.md §6). One row per GitHub webhook delivery this
// endpoint has verified and accepted — the audit ledger for `POST /api/webhooks/github`
// and the record the sweeper (Prompt 4) re-drives on a stuck dispatch. Rows are written
// for every allow-listed event/action (apps/api/src/modules/webhooks/event-allowlist.ts);
// an unknown `X-GitHub-Event` gets a 200 and a warn log, never a row — see that file's
// own comment for why "rejected" in §4 Security means "no row, no dispatch", not a
// non-2xx status.
//
// `status` is a plain `String`, not a Postgres enum — the same asymmetry
// `Repository.connectionStatus` already has next to the real `IndexStatus` enum
// (docs/decisions/phase-02-log.md §5), and `IndexJob.status` repeats it (phase-03 §6).
// Introducing a fourth, enum-backed style for this table's status column would be a
// second convention to reconcile against the two the codebase already settled on for
// exactly this shape of field; the legal values are pinned instead as
// `WebhookEventStatus` in `@repo/shared`'s `webhooks.ts`.
//
// `@@index([repositoryFullName, createdAt(sort: Desc)])` is **not** in phase-06 §6's own
// Prisma block. It is added because the recent-deliveries endpoint (Prompt 4) queries
// exactly `WHERE repositoryFullName = ? ORDER BY createdAt DESC`, and this table is an
// append-only audit ledger that only grows — an unindexed `ORDER BY ... DESC` over that
// shape is a latency regression waiting to happen in production, not a hypothetical.
//
// **Deliberately has no `repositoryId` and no relation to `Repository`.** A single
// webhook delivery (say, an `installation_repositories` event) can fan out to several
// repositories, and those repositories can belong to different projects — a `Repository`
// row is a (project, githubRepo) pair, so a single FK on this table would be a lie the
// moment more than one repository is affected. `repositoryFullName` (nullable — some
// event types, like `installation`, have none) is the routing key the fan-out is keyed
// on instead; the standalone `@@index([githubRepoId])` on `Repository` (added in Phase
// 02 specifically for this) is what the router uses to resolve it to every matching row.
//
// `payloadRef String?` is declared exactly as phase-06 §6 has it — "a blob storage
// pointer, 30-day TTL" — and left **always null** in this phase. No blob/object storage
// exists anywhere in this system yet, and building one is out of scope for webhook
// ingestion; this follows the same "declare a later-phase field now, populate it later"
// pattern `Repository.indexedCommitSha`/`reviewProfile`/etc. already use
// (docs/decisions/phase-02-log.md §4).
//
// `dispatchPayload Json?` is the one column phase-06 §6 does **not** list. It holds the
// *resolved* `PullRequestReviewRequestedData` payload(s) this delivery produced — written
// just before the Inngest send, read by the sweeper (Prompt 4) to re-send a dispatch that
// never completed. Storing the resolved payload rather than the raw GitHub delivery body
// is deliberate, not an oversight: it is a few hundred bytes rather than the tens of
// kilobytes a full `pull_request` payload can run to, and — more importantly — re-running
// tenant resolution at sweep time could legitimately produce a *different* fan-out than
// the one this delivery actually resolved to at ingestion time (a repository connected or
// disconnected in between). Replaying the payload that was actually resolved is the only
// way the sweep re-sends what this delivery was supposed to trigger, not whatever the
// world looks like now.
model WebhookEvent {
  id                  String    @id @default(uuid())
  deliveryId          String    @unique
  eventType           String
  action              String?
  installationId      BigInt?
  repositoryFullName  String?
  payloadRef          String?
  dispatchPayload     Json?
  status              String    @default("PENDING")
  dispatchedAt        DateTime?
  error               Json?
  createdAt           DateTime  @default(now())

  @@index([status, createdAt])
  @@index([repositoryFullName, createdAt(sort: Desc)])
}

// Phase 06 (phase-06-webhook-ingestion.md §6). The **minimal** row a `pull_request`
// webhook can populate on its own, with no GitHub API call to enrich it — every column
// below comes straight out of the webhook payload the router already has in hand.
//
// Phase 07 (sub-task 1.4) extends this model additively with `title`, `body`,
// `authorLogin`, `authorAvatarUrl`, `baseRef`, `baseSha`, `headRef`, `htmlUrl`,
// `additions`, `deletions`, `changedFileCount`, `latestReviewId`, and GitHub's own
// timestamps, now that Phase 07 actually needs them for review. **Every new column is
// nullable** — `upsertMinimal` (apps/api/src/modules/webhooks/pull-request.repository.ts)
// still writes only the original six fields by design (see that function's own doc
// comment), so a `synchronize` webhook re-upserting this row can never wipe this phase's
// enrichment; only Phase 07's own write path (a later prompt) ever populates them.
//
// `@@unique([repositoryId, number])`, not a unique constraint on `githubPrId` alone: the
// same GitHub pull request can legitimately produce two rows here, exactly as the same
// GitHub repository can produce two `Repository` rows — one PR, two projects, two
// independent connections (`repository.repository.ts`'s own header comment makes the
// identical argument for `githubRepoId`). Keying the constraint on `(repositoryId,
// number)` keeps each project's copy independent; `githubPrId` is retained as a plain
// column so a consumer that already has the GitHub-global id (a future GraphQL lookup,
// say) does not have to resolve it back through `(repositoryId, number)` first.
model PullRequest {
  id             String    @id @default(uuid())
  repositoryId   String
  number         Int
  githubPrId     BigInt
  headSha        String
  state          String
  isDraft        Boolean   @default(false)

  // --- Phase 07 enrichment — every field nullable; see the model comment above. ---
  title             String?
  body              String?
  authorLogin       String?
  authorAvatarUrl   String?
  baseRef           String?
  baseSha           String?
  headRef           String?
  htmlUrl           String?
  additions         Int?
  deletions         Int?
  changedFileCount  Int?
  // Plain id, deliberately not a `@relation` — the identical "an id column that names a
  // sibling row without wanting that row's delete to cascade back through here" choice
  // `CodeSymbol.parentSymbolId` already makes (see that field's own comment). A fast
  // "what's the current review for this PR" pointer that a later prompt maintains;
  // `Review.pullRequestId` (below) is the real, FK-backed relation everything else reads.
  latestReviewId    String?
  githubCreatedAt   DateTime?
  githubUpdatedAt   DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  // Phase 07 — every review attempt run against this PR, across every commit. Cascades:
  // a PullRequest row is never expected to be deleted in practice (GitHub never deletes a
  // PR, only closes it), but if one ever is, its review history should not survive it
  // orphaned.
  reviews    Review[]

  @@unique([repositoryId, number])
  @@index([repositoryId, state])
  // Phase 07 sub-task 1.4 — not in Phase 06's own index list. A project/repository
  // dashboard listing "most recently active PRs" orders by GitHub's own updated_at, not
  // by this row's local `updatedAt` (which also ticks on purely-local writes, like a
  // review completing, that are not "PR activity" from GitHub's point of view).
  @@index([repositoryId, githubUpdatedAt(sort: Desc)])
}

// Phase 07 (PR ingestion) — the manifest, not the content: turns a webhook event into a
// persisted, classified, prioritized snapshot of a PR (a `Review` row, one
// `PullRequestFile` row per changed file, and a diff position map per file). No LLM
// call, no vector search, no finding is produced by this phase — that is a later
// phase's job, reading the rows below.
//
// **Provenance note**: the phase-07 spec document this schema is modeled on is not
// present in this repository checkout (only referenced by earlier phases' own doc
// comments as external material, the same way `plan.md` is referenced throughout this
// file without being checked in). Every field below traces to an explicit requirement
// named in Prompt 1's own sub-task 1.4 text — `idempotencyKey`'s shape and uniqueness,
// the input/output token/cost columns, the three named `Review` indexes, the four
// `Review` relations, `PatchBlob`'s exact shape — or to the established sibling-model
// pattern (`Repository`/`RepositoryFile`/`PullRequest`/`IndexJob`) where the prompt is
// silent, never invented speculatively. Per this repo's own non-negotiable rule 2
// ("the codebase wins on conflicts... follow the real layout and record the override in
// a comment"), this note is that record.

enum ReviewStatus {
  PENDING
  WAITING_FOR_INDEX
  RUNNING
  AGGREGATING
  PUBLISHING
  COMPLETED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum ReviewDepth {
  DEEP
  SHALLOW
  SKIP
}

// One row per **review attempt**, not one row per PR — a PR gets a new `Review` on
// every reviewable commit (a fresh `headSha`), and `idempotencyKey`'s uniqueness is what
// stops the same attempt from being double-created under concurrent webhook deliveries.
// A newer commit landing while an older `Review` is still in flight moves the older one
// to `SUPERSEDED` rather than deleting it — every attempt survives for audit history.
//
// `projectId`/`repositoryId` are **denormalized, unrelated columns** — deliberately not
// `@relation` fields. The authoritative ownership chain is `Review → pullRequest →
// repository → project`, resolved in one query by `review.repository.ts`'s
// `findOwnershipById` (sub-task 1.5); these two columns exist only so a caller that
// already has them in hand (every Prompt 2+ Inngest function starts from
// `PullRequestReviewRequestedData`, which already carries both) never has to re-derive
// them with a join just to log or scope a query — the identical "avoid a round trip for
// what the caller already knows" argument `RepositoryIndexRequestedData`/
// `PullRequestReviewRequestedData` (`@repo/shared`'s `events.ts`) already make for their
// own `projectId` field. `projectId` additionally carries a required index (below) for
// a project-wide "recent review activity across every repository" query; `repositoryId`
// has no index of its own because no such requirement was named for it — declared
// anyway because leaving it out would make `repositoryId` unavailable everywhere except
// through a join, for a value every writer already has for free.
model Review {
  id           String @id @default(uuid())
  projectId    String
  repositoryId String

  pullRequestId String
  // Built ONLY by `@repo/shared`'s `buildIdempotencyKey` (sub-task 1.2) —
  // `apps/api` builds it to look up an existing review, `apps/worker` builds it to
  // insert one. This unique constraint is the actual concurrency guard; if the two
  // call sites ever built the key differently, the guard would silently stop working
  // while every single-sided unit test kept passing (see that function's own comment).
  idempotencyKey String @unique

  status ReviewStatus @default(PENDING)
  // REVIEW_TRIGGERS (@repo/shared) — a plain String column, not a Postgres enum,
  // matching the `Repository.connectionStatus` / `IndexJob.status` precedent this
  // schema already follows throughout (docs/decisions/phase-02-log.md §5).
  trigger String

  headSha String
  baseSha String

  // CONTEXT_QUALITIES (@repo/shared) — FULL | DEGRADED. Null until the index-readiness
  // gate (a later prompt) resolves which of the two this run actually got; a review
  // that never reached that gate (failed earlier) legitimately has no answer.
  contextQuality String?

  // Declared now, populated starting Phase 09 — the same "declare a later-phase field
  // now" pattern `Repository.indexedCommitSha` already uses (docs/decisions/
  // phase-02-log.md §4), so the LLM-calling phase does not need a schema migration just
  // to start recording spend.
  inputTokens        Int?
  outputTokens        Int?
  estimatedCostCents Int?

  // { code, message, ...details } — the same shape `IndexJob.error`/`Repository.indexError`
  // already use for a terminal failure.
  error Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pullRequest PullRequest       @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  files       PullRequestFile[]
  jobs        ReviewJob[]
  patchBlobs  PatchBlob[]

  @@index([pullRequestId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([status])
}

// One row per file changed in the PR **as of this `Review`'s `headSha`** — scoped to a
// `Review`, deliberately NOT to a `PullRequest`, because the changed-file set differs
// between commits on the same PR (a `synchronize` webhook can add, remove, or leave
// unchanged any file relative to the previous commit's set). Scoping to `PullRequest`
// instead would force every new commit to somehow reconcile against the previous
// commit's file list rather than simply writing a fresh one.
model PullRequestFile {
  id       String @id @default(uuid())
  reviewId String

  path String
  // GitHub reports the pre-rename path only when `status` is "renamed"/"copied"; null
  // otherwise. Lets a later prompt resolve a renamed file back to its `RepositoryFile`
  // row under its old path when the new path alone doesn't match.
  previousPath String?

  // PULL_REQUEST_FILE_STATUSES (@repo/shared) — GitHub's own `added`/`removed`/
  // `modified`/`renamed`/`copied`/`changed`/`unchanged`, copied verbatim, matching the
  // identical "keep GitHub's own spelling" choice `webhooks.ts`'s `PULL_REQUEST_STATES`
  // already makes for `PullRequest.state` (see that union's own doc comment).
  status    String
  additions Int
  deletions Int
  changes   Int

  // The blob sha GitHub reports for this file's contents at `Review.headSha` — null for
  // a removed file (GitHub omits it). Not a commit sha; this row already belongs to
  // exactly one `Review`, which already names the commit.
  sha String?

  // sub-task 1.6 (patch store) — `inline:<patch text>` | `blob:<PatchBlob.id>` | null (no
  // patch supplied: a binary or over-GitHub's-own-size-cap file). Written by
  // `apps/worker/src/lib/patch-store.ts`; `apps/api` never reads the patch body itself in
  // this phase, only this pointer.
  patchRef   String?
  patchBytes Int     @default(0)

  // The real Prisma enum `RepositoryFile.classification` already uses — reused
  // directly, not re-declared, since this is the identical vocabulary classifying the
  // identical kind of fact (a file's role), just for a file that may not have a
  // `RepositoryFile` row yet (newly added in this PR; the repository has not been
  // re-indexed at this exact commit).
  classification FileClassification @default(UNKNOWN)
  // CLASSIFICATION_REVIEW_DEPTH (@repo/shared) maps a classification to this — a real
  // Postgres enum (declared above), unlike every String-typed vocabulary on this model.
  depth          ReviewDepth
  // plan.md §17.1 — Prompt 3's formula, over `RepositoryFile.inboundEdgeCount`/
  // `symbolCount` (joined live by `(repositoryId, path)`, not duplicated onto this row —
  // see this model's own header comment on why no `repositoryFileId` is stored).
  priorityScore  Float               @default(0)

  // PULL_REQUEST_FILE_REVIEW_STATUSES (@repo/shared) — this system's own progress
  // through the review pipeline, independent of `status` above (GitHub's diff
  // classification of the file, not this system's review progress).
  reviewStatus String @default("PENDING")

  // OVERSIZED_FILE_DIFF_LINES (@repo/shared) — flagged, not acted on, in this phase;
  // splitting an oversized diff into reviewable pieces is a later phase's job.
  isOversized Boolean @default(false)

  // The reason sub-task 1.1's own framing names this phase's real deliverable: which
  // lines of this file's diff GitHub's Review API will legally accept an inline comment
  // on. Shape is left to whichever later phase is the first real consumer; this phase
  // only computes and stores it. Null until a later prompt populates it.
  diffPositionMap Json?

  error     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, path])
  @@index([reviewId, reviewStatus])
  // Prompt 3+'s fan-out reads files in priority order — the entire point of computing
  // the score in the first place.
  @@index([reviewId, priorityScore(sort: Desc)])
}

// The Postgres mirror of Inngest run state for the review pipeline (plan.md §27.6:
// "Inngest is the executor, Postgres is the status of record") — the identical role
// `IndexJob` already plays for the indexing pipeline. The UI polls this table, never the
// Inngest API. One row per unit of work Inngest actually schedules: the overall PROCESS
// run, one FILE job per reviewed file, the AGGREGATE step, and the PUBLISH step that
// posts results back to GitHub (REVIEW_JOB_KINDS, @repo/shared).
model ReviewJob {
  id       String @id @default(uuid())
  reviewId String

  // REVIEW_JOB_KINDS (@repo/shared) — PROCESS | FILE | AGGREGATE | PUBLISH.
  kind String
  // REVIEW_JOB_STATUSES (@repo/shared) — PENDING | RUNNING | SUCCEEDED | FAILED.
  status String @default("PENDING")

  // Set only for kind="FILE" — the specific file this job reviews. Plain id, not a
  // `@relation`, for the identical reason `PullRequest.latestReviewId` isn't one either
  // (see that field's own comment): a fast pointer a later prompt maintains, not a
  // relationship this schema wants cascade-delete semantics for.
  pullRequestFileId String?

  inngestRunId String?
  attempts     Int     @default(0)
  error        Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, kind])
}

// **Not in the spec — a deliberate, argued addition.** `PullRequestFile.patchRef` needs
// to point somewhere when a patch exceeds `PATCH_INLINE_MAX_BYTES` (@repo/shared,
// sub-task 1.6), and the spec's own field list requires that pointer to name "blob
// storage" — but no object storage (S3, R2, or otherwise) exists anywhere in this
// system, and no env var for one is configured (sub-task 1.4's own review of this).
// Introducing one here would mean new credentials, a new failure mode, and new deploy
// configuration for a path that is by definition rare (most patches are well under
// 64 KiB). A separate Postgres table achieves the actual goal — keeping the hot-path
// `PullRequestFile` row small, since no query on the review pipeline selects
// `PatchBlob.content` unless it specifically wants that one patch — at zero
// infrastructure cost, and leaves `patchRef`'s `scheme:value` format (`inline:`/`blob:`)
// as a clean seam to swap in real object storage later without a schema change.
model PatchBlob {
  id       String @id @default(uuid())
  reviewId String
  path     String
  content  String @db.Text
  byteSize Int

  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, path])
  @@index([reviewId])
}

// --- Auth.js adapter tables (@auth/prisma-adapter) ---
// Field shapes verified against the installed adapter's own source (not the docs) —
// see docs/decisions/phase-01-log.md. `Authenticator` (WebAuthn) is deliberately
// omitted: the adapter exposes methods for it, but they're only invoked when a
// WebAuthn provider is configured, which this phase never does (GitHub OAuth only).

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
