# Phase 00 — required now (apps/api, apps/worker, packages/db). See
# phase-00-foundation.md §19 and phase-01-authentication-and-projects.md §19.
# Names only, never values — this file is committed, .env is not.
#
# Per-environment guidance (and the OAuth callback-URL gotcha) lives in
# docs/deployment.md.

# Postgres connection string. Local dev: docker compose up, then
# postgresql://postgres:postgres@localhost:5432/dev
DATABASE_URL=

# development | test | production
NODE_ENV=

# debug | info | warn | error — optional, defaults to "info"
LOG_LEVEL=

# Dev keys from `pnpm dev:inngest` are fine locally
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Point the Inngest SDK at the local Dev Server instead of Inngest Cloud. Set it to 1
# in BOTH apps/api/.env and apps/worker/.env for local development.
#
# Found the hard way during Phase 02's smoke pass: apps/worker/.env had this and
# apps/api/.env did not, so every event the API emitted went to inn.gs and came back
# "401 Event key not found" — logged correctly, and silently dropped, because emission
# is deliberately non-fatal (see apps/api/src/inngest/emit.ts). With it set, the event
# lands in the Dev Server UI, which is phase-02 §8's acceptance signal.
INNGEST_DEV=

# apps/api's own Express port + the frontend origin it allows via CORS — not in
# plan.md (which assumes one Next.js app with no separate backend port); required by
# this repo's apps/api + apps/web split. See docs/decisions/phase-00-log.md §1/§5.
PORT=
FRONTEND_URL=

# apps/worker's Express port (serves /api/inngest for the Inngest Dev Server)
WORKER_PORT=

# apps/web only (lives in apps/web/.env.local, not the root .env — Next.js inlines
# NEXT_PUBLIC_* at build time). The origin apps/api is reachable at, from both the
# browser and apps/web's server components. Must be the SAME SITE as the frontend
# origin, or the sameSite=lax session cookie will not be sent — see docs/deployment.md.
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------------
# Phase 01 — GitHub OAuth sign-in via Auth.js (phase-01 §19).
#
# This is the OAuth App (who is logged in), deliberately NOT the GitHub App
# (what repository data we can read) — those are separate credentials and are never
# conflated (phase-01 §13). The GitHub App variables below stay unwired until Phase 02.
#
# AUTH_URL must differ per environment and must match the OAuth App's registered
# callback URL exactly ($AUTH_URL/api/auth/callback/github). This is the single most
# common failure in this phase — see docs/deployment.md before debugging anything else.
#
# The sign-in flow itself is documented in docs/auth.md, along with the
# requireTenantAccess pattern every authenticated route uses.
# ---------------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=

# ---------------------------------------------------------------------------------
# Phase 02 — the GitHub App + Redis (phase-02 §19).
#
# This is the GitHub *App* — what repository data the system may read and where it may
# publish review comments. It is deliberately NOT the OAuth App above, which only
# answers "who is signed in". Two separate registrations, two separate credential sets,
# never interchangeable: plan.md §45 names conflating them as a top failure point for
# this phase.
#
# Creating the App, choosing its permissions, and downloading the private key are all
# documented step by step in docs/github-app-setup.md. The rationale for each requested
# permission (and for the ones deliberately not requested) is in
# docs/github-app-permissions.md.
#
# One App per environment — a single App has one webhook URL and one callback URL, so
# sharing one between local/staging/production sends every environment's events to
# whichever URL was configured last. Same trap as the OAuth callback URL above.
# ---------------------------------------------------------------------------------

# The numeric App ID from the App's settings page (used as the JWT `iss` claim).
GITHUB_APP_ID=

# The App's private key (.pem downloaded from GitHub), **base64-encoded**:
#   base64 -w0 your-app.private-key.pem
# Base64 is used because a PEM is multi-line and most .env loaders and hosting
# providers mangle real newlines. apps/api decodes and shape-checks this at boot and
# refuses to start if it is not a PKCS#1/PKCS#8 PEM, so a mangled key fails loudly at
# startup rather than on the first GitHub call. A raw multi-line PEM is also accepted
# for local convenience (dotenv supports multi-line double-quoted values).
GITHUB_APP_PRIVATE_KEY=

# The App's URL slug — the last path segment of https://github.com/apps/{slug}. Used to
# build the "Install GitHub App" link (https://github.com/apps/{slug}/installations/new).
GITHUB_APP_SLUG=

# HMAC secret set on the App's webhook settings. Generate it with `openssl rand -hex 32`.
# Consumed by apps/api/src/modules/webhooks/webhook-verification.ts, via
# receiveGithubWebhook (apps/api/src/controllers/webhooks.controller.ts) — the sole
# authentication on POST /api/webhooks/github (there is no session/cookie on that route;
# the HMAC over the raw request body IS the authentication). Point the GitHub App's
# webhook URL at <API origin>/api/webhooks/github; see docs/webhooks.md for the full
# event/action matrix this endpoint handles and for what a spike in signature-rejection
# logs means operationally (a rotated-but-not-redeployed secret, or a leaked one).
GITHUB_APP_WEBHOOK_SECRET=

# First use of Redis in the system: the installation-access-token cache (~50 min TTL
# against GitHub's 60 min expiry). Local dev: docker compose up, then
# redis://localhost:6379. Must start with redis://, rediss://, or unix://.
REDIS_URL=

# ---------------------------------------------------------------------------------
# Phase 03 — apps/worker becomes a real deployable (phase-03 §19).
#
# apps/worker now needs its own DATABASE_URL and its own copy of the GitHub App
# credentials (GITHUB_APP_ID/GITHUB_APP_PRIVATE_KEY/REDIS_URL above — same values as
# apps/api's, this is one App, read by two deployables) to mint installation tokens and
# fetch a repository tarball directly, without going through apps/api. It does NOT need
# GITHUB_APP_SLUG or GITHUB_APP_WEBHOOK_SECRET — it never builds an install link and
# never receives a webhook.
# ---------------------------------------------------------------------------------

# apps/worker only. Scratch directory (tmpfs in the container) for tarball extraction.
# Optional — defaults to a container-standard temp path. See Dockerfile.worker.
WORKER_TEMP_DIR=

# apps/worker only. Hard cap on total extracted bytes per repository — the zip-bomb
# defense (phase-03 §4 Security). Optional, defaults to 2 GiB (2147483648). Exposed as a
# var for MVP tuning without a redeploy, not because you should need to change it.
INDEX_MAX_TOTAL_BYTES=

# apps/worker only. Hard cap on total file count per repository. Optional, defaults to
# 200000.
INDEX_MAX_FILE_COUNT=

# ---------------------------------------------------------------------------------
# Phase 05 — chunking, embedding, and the debug search panel (phase-05-vector-search.md
# §19, docs/decisions/phase-05-log.md Prompt 3).
# ---------------------------------------------------------------------------------

# apps/worker only, unconditionally required — every index run embeds chunks. The API
# key for @repo/embeddings' RealEmbeddingProvider (Voyage AI's /v1/embeddings endpoint;
# see packages/embeddings/src/embedding/provider.ts for why that provider was chosen).
EMBEDDING_API_KEY=

# apps/worker only, unconditionally required, and deliberately has NO DEFAULT anywhere
# in code — which embedding model is in use must be a tracked, deliberate config
# change, never silent drift. Changing this value without a corresponding re-index (or
# without truncating EmbeddingCache) means new chunks are cached under the new model
# while old ones remain under the old one until re-embedded — see
# packages/embeddings/src/embedding/embedding-cache.repository.ts's own header comment
# for the full model-identity decision. Example: voyage-code-3
EMBEDDING_MODEL=

# apps/worker only, unconditionally required. Prompt 4 uses this for the ReviewProfile
# step (spec §9) — a separate credential from EMBEDDING_API_KEY even though both are
# "AI API keys," because they are two independent provider calls that can fail, retry,
# and rotate independently. Supersedes the placeholder AI_API_KEY name in the reserved
# block below — see that entry's own note.
LLM_API_KEY=

# apps/api only, optional, defaults to false. Gates the debug search panel (Prompt 5) —
# apps/api does not need an embedding provider at all unless this is "true", so
# EMBEDDING_API_KEY/EMBEDDING_MODEL below are only enforced (apps/api/src/lib/config.ts's
# own superRefine) when this is "true". Must be the literal string "true" to enable;
# anything else (including unset) is treated as false.
DEBUG_SEARCH_ENABLED=

# apps/api only. Required only when DEBUG_SEARCH_ENABLED=true — otherwise apps/api never
# reads either variable, and every existing deployment/CI run keeps booting with neither
# set. Same values as apps/worker's own EMBEDDING_API_KEY/EMBEDDING_MODEL above (one
# provider account, read by two deployables) when the panel is turned on.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------------------------------------------------------------------------------
# Reserved for later phases — not wired up by any code yet. Listed here so the
# variable names are settled in advance; do not remove.
#
# GITHUB_APP_ID and GITHUB_PRIVATE_KEY used to live in this block. They were promoted
# into the Phase 02 section above, and GITHUB_PRIVATE_KEY was renamed to
# GITHUB_APP_PRIVATE_KEY to match phase-02 §19 and to keep the App-vs-OAuth distinction
# visible in the name itself (docs/decisions/phase-02-log.md).
#
# QDRANT_URL / QDRANT_API_KEY: Phase 05 Decision D1 chose pgvector over Qdrant for the
# MVP (packages/db/src/vector/vector-store.interface.ts's own header comment has the
# full trade-off and the ~30-50M-vector scale threshold for revisiting it). These two
# remain reserved only for that future migration — nothing in this codebase reads them
# today, and nothing should until that migration is a real, separate piece of work.
# ---------------------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Superseded by LLM_API_KEY above (Phase 05 prompt 3) — this placeholder predates any
# actual AI provider call in the codebase and was never wired to anything. Kept, unused,
# rather than removed, per this block's own "do not remove" instruction; a future phase
# should either wire it to a second, genuinely distinct provider or delete it outright,
# not leave a reader guessing which of the two names is the real one.
AI_API_KEY=
