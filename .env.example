# Phase 00 — required now (apps/api, apps/worker, packages/db). See
# phase-00-foundation.md §19 and phase-01-authentication-and-projects.md §19.
# Names only, never values — this file is committed, .env is not.
#
# Per-environment guidance (and the OAuth callback-URL gotcha) lives in
# docs/deployment.md.

# Postgres connection string. Local dev: docker compose up, then
# postgresql://postgres:postgres@localhost:5432/dev
DATABASE_URL=

# development | test | production
NODE_ENV=

# debug | info | warn | error — optional, defaults to "info"
LOG_LEVEL=

# Dev keys from `pnpm dev:inngest` are fine locally
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# apps/api's own Express port + the frontend origin it allows via CORS — not in
# plan.md (which assumes one Next.js app with no separate backend port); required by
# this repo's apps/api + apps/web split. See docs/decisions/phase-00-log.md §1/§5.
PORT=
FRONTEND_URL=

# apps/worker's Express port (serves /api/inngest for the Inngest Dev Server)
WORKER_PORT=

# apps/web only (lives in apps/web/.env.local, not the root .env — Next.js inlines
# NEXT_PUBLIC_* at build time). The origin apps/api is reachable at, from both the
# browser and apps/web's server components. Must be the SAME SITE as the frontend
# origin, or the sameSite=lax session cookie will not be sent — see docs/deployment.md.
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------------
# Phase 01 — GitHub OAuth sign-in via Auth.js (phase-01 §19).
#
# This is the OAuth App (who is logged in), deliberately NOT the GitHub App
# (what repository data we can read) — those are separate credentials and are never
# conflated (phase-01 §13). The GitHub App variables below stay unwired until Phase 02.
#
# AUTH_URL must differ per environment and must match the OAuth App's registered
# callback URL exactly ($AUTH_URL/api/auth/callback/github). This is the single most
# common failure in this phase — see docs/deployment.md before debugging anything else.
#
# The sign-in flow itself is documented in docs/auth.md, along with the
# requireTenantAccess pattern every authenticated route uses.
# ---------------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=

# ---------------------------------------------------------------------------------
# Reserved for later phases — not wired up by any code yet. Listed here so the
# variable names are settled in advance; do not remove.
# ---------------------------------------------------------------------------------
REDIS_URL=

QDRANT_URL=
QDRANT_API_KEY=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

AI_API_KEY=
