# Phase 00 — required now (apps/api, packages/db). See phase-00-foundation.md §19.
# Names only, never values — this file is committed, .env is not.

# Postgres connection string. Local dev: docker compose up, then
# postgresql://postgres:postgres@localhost:5432/dev
DATABASE_URL=

# development | test | production
NODE_ENV=

# debug | info | warn | error — optional, defaults to "info"
LOG_LEVEL=

# Dev keys from `npx inngest-cli@latest dev` are fine locally
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# apps/api's own Express port + the frontend origin it allows via CORS — not in
# plan.md (which assumes one Next.js app with no separate backend port); required by
# this repo's apps/api + apps/web split. See docs/decisions/phase-00-log.md §1/§5.
PORT=
FRONTEND_URL=

# ---------------------------------------------------------------------------------
# Reserved for later phases — not wired up by any code yet. Listed here so the
# variable names are settled in advance; do not remove. CLERK_SECRET_KEY in
# particular conflicts with phase-00's binding Auth.js/NextAuth decision (§1) — see
# docs/decisions/phase-00-log.md §5, unresolved until Phase 01.
# ---------------------------------------------------------------------------------
REDIS_URL=

QDRANT_URL=
QDRANT_API_KEY=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

CLERK_SECRET_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

AI_API_KEY=
